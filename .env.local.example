# ============================================================
#  ENVIRONMENT VARIABLES - Perpustakaan Griya Baca
#  Salin file ini menjadi .env.local lalu isi nilainya.
# ============================================================

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service Role Key (RAHASIA! hanya dipakai di server & script seed)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Google Books API (opsional, menaikkan limit) ---
GOOGLE_BOOKS_API_KEY=AIza...

# --- Google Gemini API (untuk Scan Cover / AI Vision) ---
GEMINI_API_KEY=AIza...

# --- Domain untuk email internal admin ---
# Admin login pakai username; di balik layar dipetakan ke username@DOMAIN ini.
NEXT_PUBLIC_ADMIN_EMAIL_DOMAIN=griyabaca.local

# --- URL situs (untuk redirect Google Login) ---
# Saat lokal: http://localhost:3000  | Saat online: https://perpustakaankkn298.my.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000
